FROM python:3.13-slim

WORKDIR /workspace

# Install system dependencies needed for image processing (OpenCV/Pillow)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source files and resources
COPY app/backend/ /workspace/

EXPOSE 8000

CMD ["python", "main.py"]